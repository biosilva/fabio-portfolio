---
/** Bordered box with a short description and an image beside (or below) it. */
interface Props {
  title?: string;
  layout?: "row" | "stack";
}
const { title, layout = "row" } = Astro.props;
---

<section class:list={["box", layout]}>
  <div class="text">
    {title && <h3 class="title">{title}</h3>}
    <slot name="text" />
  </div>
  <div class="media">
    <slot />
  </div>
</section>

<style>
  .box {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--line);
  }
  .row {
    grid-template-columns: 1fr 1fr;
  }
  .stack {
    grid-template-columns: 1fr;
  }
  .text {
    display: grid;
    gap: 0.75rem;
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--text-secondary);
  }
  .title {
    font-size: var(--fs-small);
    font-weight: 400;
    color: var(--text);
  }
  .media {
    display: grid;
    gap: 1.5rem;
  }
  @media (max-width: 809.98px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
