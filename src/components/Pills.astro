---
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<ul class="pills" aria-label="Focus areas">
  {items.map((t) => <li>{t}</li>)}
</ul>

<style>
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }
  li {
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: var(--fs-xs);
    line-height: 1.4;
    white-space: nowrap;
  }
</style>
