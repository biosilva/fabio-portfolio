---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Max rendered width in px — used for responsive `sizes`. */
  maxWidth?: number;
  rounded?: boolean;
  priority?: boolean;
  class?: string;
}

const { src, alt, caption, maxWidth = 960, rounded = false, priority = false, class: className } = Astro.props;
const widths = [480, 800, 1200, 1600, 2000].filter((w) => w <= src.width);
---

<figure class:list={["figure", className, { rounded }]}>
  {caption && <figcaption class="eyebrow">{caption}</figcaption>}
  <Image
    src={src}
    alt={alt}
    widths={widths.length ? widths : [src.width]}
    sizes={`(min-width: ${maxWidth + 80}px) ${maxWidth}px, calc(100vw - 2.5rem)`}
    format="webp"
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : undefined}
  />
</figure>

<style>
  .figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  .figure :global(img) {
    width: 100%;
  }
  .rounded :global(img) {
    border-radius: var(--radius);
  }
  figcaption {
    text-align: center;
  }
</style>
